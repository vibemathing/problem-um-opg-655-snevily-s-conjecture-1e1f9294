{"attempt_id": "attempt:um-opg-655-snevily-s-conjecture-1e1f9294-source-fidelity-01", "created_at": "2026-09-06T15:37:58Z", "graph_id": "graph:um-opg-655-snevily-s-conjecture-1e1f9294-v1", "obligations": [{"acceptance": {"allowed_candidate_kinds": ["proof", "counterexample", "formalization", "computation"], "required_capabilities": ["human_review", "statement_faithfulness"]}, "dependencies": ["obligation:um-opg-655-snevily-s-conjecture-1e1f9294-statement-fidelity"], "kind": "root_claim", "obligation_id": "obligation:um-opg-655-snevily-s-conjecture-1e1f9294-root", "source_refs": ["https://www.unsolvedmath.com/problems/OPG-655"], "statement": {"formal_declaration": null, "language": "en", "text": "Conjecture Let $G$ be an abelian group of odd order and let $A,B \\subseteq G$ satisfy $|A| = |B| = k$. Then the elements of $A$ and $B$ may be ordered $A = \\{a_1,\\ldots,a_k\\}$ and $B = \\{b_1,\\ldots,b_k\\}$ so that the sums $a_1+b_1, a_2+b_2 \\ldots, a_k + b_k$ are pairwise distinct."}, "statement_sha256": "dac1a0ce0f844edb0606af1a403985ceb3ddb997efd6f15b673d0c3d44465c27"}, {"acceptance": {"allowed_candidate_kinds": ["proof"], "required_capabilities": ["human_review", "statement_faithfulness"]}, "dependencies": [], "kind": "definition", "obligation_id": "obligation:um-opg-655-snevily-s-conjecture-1e1f9294-statement-fidelity", "source_refs": ["https://www.unsolvedmath.com/problems/OPG-655"], "statement": {"formal_declaration": null, "language": "en", "text": "Verify against the cited source that the frozen statement is complete, current, untruncated, attribution-correct, and unambiguous enough for mathematical research; record any definition or quantifier gap without silently editing the contract."}, "statement_sha256": "65f0b3d574bd6d837403149dab6434c0f571709f7eb5bb066c7e8774bad13f34"}], "problem_contract_sha256": "dc36cdbfb1cc8da91b2562e6fa3ec7f792ea862fb328bc7e167c317e2e97f421", "problem_id": "problem:um-opg-655-snevily-s-conjecture-1e1f9294", "root_obligation_id": "o